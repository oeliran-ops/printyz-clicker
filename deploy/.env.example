# Copy to .env ON THE SERVER ONLY. Never commit .env and never paste these values into a chat.
DOMAIN=printyz.co.il
PRINTYZ_SITE_NAME=Printyz
PRINTYZ_BASE_URL=https://printyz.co.il
PRINTYZ_ADMIN_PASSWORD=
# long random string, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
PRINTYZ_SECRET_KEY=
# where new orders are sent
PRINTYZ_OWNER_EMAIL=
# SMTP of the business mailbox (Gmail: smtp.gmail.com, port 587, an "App password")
PRINTYZ_SMTP_HOST=
PRINTYZ_SMTP_PORT=587
PRINTYZ_SMTP_USER=
PRINTYZ_SMTP_PASSWORD=
PRINTYZ_MAIL_FROM=
# optional free WhatsApp alert to the owner (CallMeBot); number in 9725XXXXXXXX format
PRINTYZ_OWNER_WHATSAPP=
PRINTYZ_CALLMEBOT_APIKEY=
PRINTYZ_GEOMETRY_WORKERS=2
